# Copie para .env e preencha com os seus dados. Não versione o .env.
# Use aspas duplas para valores com espaços ou #.
# Dentro de aspas duplas, escape aspas com \" e barras invertidas com \\.

# Lista JSON em uma única linha; a ordem define a prioridade das tentativas.
# Uma senha vazia ("senha":"") indica rede aberta.
# Para um apóstrofo dentro do JSON, use \u0027.
WIFI_REDES='[{"nome":"RedeCasa","senha":"SENHA_CASA"},{"nome":"RedeFaculdade","senha":"SENHA_FACULDADE"}]'

OTA_NOME="NOME_DO_DISPOSITIVO"
OTA_SENHA="SENHA_OTA"

# Apenas o host, sem https:// e sem barra final.
SUPABASE_HOST="SEU_PROJETO.supabase.co"
SUPABASE_CAMINHO="/rest/v1/SUA_TABELA"
SUPABASE_CHAVE="SUA_CHAVE_PUBLICA"
